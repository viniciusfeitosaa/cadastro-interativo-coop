PORT=3080
ADMIN_PASSWORD=alterar-senha-forte
JWT_SECRET=gerar-string-aleatoria-longa

# Integração com AppVS (fila de aprovação em app.coopvitta.cloud)
# Na VPS, use o hostname do container backend na rede proxy-network:
APPVS_API_URL=http://coopvitta-backend:3001

# Cloudflare R2 (opcional — uploads ficam locais se não configurado)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=coopvitta-cadastros
# R2_KEY_PREFIX=cadastros
# R2_PUBLIC_BASE_URL=

MAX_UPLOAD_BYTES=26214400
